# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/water_tank_db

# Redis Configuration (Streams Buffer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_KEY=stream:water_readings
REDIS_CONSUMER_GROUP=group:water_batch_writer

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=rsa_ugm_backend_subscriber
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_LEVEL=hospital/+/level
MQTT_TOPIC_STATUS=hospital/+/status
MQTT_TOPIC_HEARTBEAT=hospital/+/heartbeat

# Batch Writer Settings
BATCH_SIZE=50
BATCH_INTERVAL_MS=3000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_hospital_monitoring_rsa_ugm
JWT_EXPIRES_IN=1d

# Gateway Sync Configuration (Raspberry Pi Key)
GATEWAY_SYNC_KEY=replace_with_strong_random_secret_in_production

# Keamanan & Akses (CORS, Rate Limiting, Dokumentasi)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_LOGIN_MAX=5
ENABLE_SWAGGER=true
