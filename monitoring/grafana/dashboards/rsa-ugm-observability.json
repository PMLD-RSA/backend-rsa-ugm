{
  "uid": "rsa-ugm-backend-observability",
  "title": "RSA UGM - Backend & IoT Pipeline Observability",
  "description": "Dashboard Observability untuk Backend API Fastify, Runtime Node.js, dan Pipa Data IoT (MQTT -> Redis -> TimescaleDB)",
  "tags": ["rsa-ugm", "backend", "iot-pipeline", "observability"],
  "timezone": "Asia/Jakarta",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Backend API & Node.js Runtime Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status Backend Target",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "up{job=\"rsa_ugm_backend\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active WebSocket Clients",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "rsa_ws_connected_clients",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Node.js RAM Heap Used",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "rsa_backend_nodejs_heap_size_used_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 157286400 },
              { "color": "red", "value": 268435456 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total HTTP 5xx Errors",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(rsa_http_requests_total{status_code=~\"5..\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Request Rate per Route (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (method, route, status_code) (rate(rsa_http_requests_total[1m]))",
          "legendFormat": "{{method}} {{route}} ({{status_code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP API Latency p95 (detik)",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(rsa_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node.js Memory (RSS & Heap) & Event Loop Lag",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "rsa_backend_process_resident_memory_bytes",
          "legendFormat": "Process RSS Memory",
          "refId": "A"
        },
        {
          "expr": "rsa_backend_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "B"
        },
        {
          "expr": "rsa_backend_nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "2. IoT Data Pipeline Health (MQTT -> Redis Stream -> TimescaleDB)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Redis Stream Queue Backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "rsa_redis_stream_pending_length",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "LoRa Duplicate Packets Filtered",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 21 },
      "targets": [
        {
          "expr": "sum(rsa_mqtt_messages_total{status=\"duplicate_dropped\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Total Alerts Triggered",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum(rsa_alerts_triggered_total) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Dead Letter Queue (Data Korup)",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 21 },
      "targets": [
        {
          "expr": "sum(rsa_batch_writer_records_total{status=\"dead_letter\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "MQTT Ingestion Rate per Topik & Status (msg/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "sum by (topic_type, status) (rate(rsa_mqtt_messages_total[1m]))",
          "legendFormat": "{{topic_type}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "TimescaleDB Batch Writer Throughput & Latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus-rsa-ugm" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "expr": "sum by (status) (rate(rsa_batch_writer_records_total[1m]))",
          "legendFormat": "Records/s ({{status}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rsa_batch_writer_duration_seconds_bucket[5m])))",
          "legendFormat": "Batch Insert p95 (s)",
          "refId": "B"
        }
      ]
    }
  ]
}
